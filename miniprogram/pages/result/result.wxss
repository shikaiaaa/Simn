/* result.wxss —— 试穿结果页（DEV-0001-08）。
   AI 标识为独立图层（不在 zoom-view 内），不随图片缩放。 */

.result-stage {
  position: relative;
  width: 100%;
  height: 66vh;
  margin-top: 16rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: #101216;
}

.result-zoom {
  display: block;
  width: 100%;
  height: 100%;
}

.result-ai-badge {
  position: absolute;
  left: 20rpx;
  top: 20rpx;
  z-index: 10;
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  background: rgba(16, 18, 22, 0.68);
  color: #ffffff;
  font-size: 24rpx;
  line-height: 1.4;
  letter-spacing: 1rpx;
  pointer-events: none;
}

.result-zoom-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 8rpx 8rpx;
}

.result-reset {
  margin: 0;
  padding: 0 24rpx;
  height: 56rpx;
  line-height: 56rpx;
  font-size: 26rpx;
}

.result-size-range {
  margin: 12rpx 0 8rpx;
  font-size: 56rpx;
  font-weight: 600;
  color: #1f2329;
}

.result-size-line {
  margin-top: 8rpx;
}

.result-size-insufficient {
  margin: 12rpx 0 8rpx;
  font-size: 30rpx;
  color: #5a626d;
}

.result-degraded {
  background: #fff7e6;
  color: #8a5a00;
  font-size: 26rpx;
  line-height: 1.6;
}

.result-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 32rpx;
}

.result-actions .btn {
  flex: 1;
}

.btn-danger {
  background: #d14343;
  color: #ffffff;
}

.result-footnote {
  margin: 24rpx 8rpx 8rpx;
  color: #8a9099;
  font-size: 24rpx;
  line-height: 1.6;
}

.result-error {
  padding-top: 160rpx;
  text-align: center;
}

.result-error-text {
  margin-bottom: 48rpx;
  color: #5a626d;
  font-size: 30rpx;
  line-height: 1.6;
}
