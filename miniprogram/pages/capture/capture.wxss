/* capture.wxss —— 人像采集页（DEV-0001-06）。 */

.page {
  height: 100vh;
}

.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin: 20rpx 0 8rpx;
}

.photo-item {
  position: relative;
  width: 210rpx;
  height: 280rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #eef1f5;
}

.photo-thumb {
  width: 100%;
  height: 100%;
  display: block;
}

.photo-status {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 56rpx;
  padding: 4rpx 12rpx;
  font-size: 22rpx;
  color: #fff;
  background: rgba(0, 0, 0, 0.45);
}

.photo-actions {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  justify-content: space-around;
  padding: 8rpx 0;
  background: rgba(0, 0, 0, 0.55);
}

.photo-actions .link {
  font-size: 24rpx;
  color: #fff;
}

.link-danger {
  color: #ffb3b3 !important;
}

.photo-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 210rpx;
  height: 280rpx;
  border: 2rpx dashed #c3c9d2;
  border-radius: 16rpx;
  color: #8a9099;
  font-size: 26rpx;
  background: #fbfcfe;
}

.photo-add-plus {
  font-size: 64rpx;
  line-height: 1;
  color: #b6bdc7;
  margin-bottom: 8rpx;
}

.field {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #eef1f5;
}

.field:last-child {
  border-bottom: none;
}

.field-label {
  width: 280rpx;
  color: #5a626d;
  font-size: 28rpx;
}

.field-input {
  flex: 1;
  font-size: 30rpx;
  text-align: right;
}

.chip-row {
  display: flex;
  gap: 16rpx;
  margin: 16rpx 0;
}

.chip {
  padding: 12rpx 40rpx;
  border-radius: 999rpx;
  border: 2rpx solid #d9dde3;
  color: #5a626d;
  font-size: 28rpx;
  background: #fff;
}

.chip-active {
  border-color: #1f2329;
  color: #fff;
  background: #1f2329;
}

.hint {
  margin-top: 8rpx;
  color: #c0392b;
  font-size: 26rpx;
  line-height: 1.5;
}

.hint-ok {
  color: #3c8c5a;
}

.form-errors {
  margin: 8rpx 0 24rpx;
}

.form-error {
  color: #c0392b;
  font-size: 26rpx;
  line-height: 1.5;
}

.disclaimer {
  margin-top: 24rpx;
  text-align: center;
  color: #a3a9b3;
  font-size: 22rpx;
  line-height: 1.5;
}
