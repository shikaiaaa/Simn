/* consent.wxss —— 合规门禁页样式（DEV-0001-05） */
.tip {
  color: #5a626d;
  font-size: 26rpx;
  margin-bottom: 16rpx;
}

.check-row {
  display: flex;
  align-items: flex-start;
  margin: 24rpx 0;
}

.checkbox {
  width: 40rpx;
  height: 40rpx;
  flex: 0 0 40rpx;
  border: 2rpx solid #c3c8cf;
  border-radius: 8rpx;
  margin-right: 16rpx;
  margin-top: 4rpx;
  font-size: 26rpx;
  line-height: 40rpx;
  text-align: center;
  color: #ffffff;
  box-sizing: border-box;
}

.checkbox.checked {
  background: #1f2329;
  border-color: #1f2329;
}

.check-text {
  flex: 1;
  color: #1f2329;
  font-size: 28rpx;
  line-height: 1.5;
}

.disclosure-item {
  border-top: 2rpx solid #eef0f3;
  padding: 16rpx 0;
}

.disclosure-label {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 6rpx;
}

.disclosure-text {
  color: #5a626d;
  font-size: 26rpx;
  line-height: 1.6;
}

.gender-note {
  color: #1f2329;
  font-size: 26rpx;
  background: #f1f3f5;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-top: 16rpx;
}

.error-text {
  color: #d33b3b;
  font-size: 26rpx;
  margin-top: 16rpx;
}

.footer-tip {
  margin-top: 24rpx;
  text-align: center;
}
