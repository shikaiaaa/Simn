/* index.wxss */
.hero {
  padding: 48rpx 8rpx 32rpx;
}

.hero-title {
  font-size: 44rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}

.hero-desc {
  color: #5a626d;
  font-size: 28rpx;
}

.tip {
  position: relative;
  padding-left: 28rpx;
  margin-bottom: 16rpx;
  color: #5a626d;
  font-size: 26rpx;
}

.tip::before {
  content: '';
  position: absolute;
  left: 0;
  top: 14rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #b9bfc7;
}

.footer-tip {
  text-align: center;
  margin-top: 24rpx;
}
